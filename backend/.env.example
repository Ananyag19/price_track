# --- Server ---
PORT=3001
# Comma-separated list of allowed frontend origins, or * for any
CORS_ORIGIN=http://localhost:5173

# --- Supabase (Project Settings -> API). Use the service_role key: it stays on the server only. ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Scheduler auth: cron-job.org must send this as "Authorization: Bearer <value>" ---
CRON_SECRET=change-me-to-a-long-random-string

# --- Target store (the only origin the scraper will ever visit) ---
STORE_BASE_URL=https://demo.inelabteamdev.com
CATALOG_PATH=/api/catalog

# --- Scraper tuning (all optional; defaults shown) ---
HEADLESS=true
SCRAPE_MAX_ATTEMPTS=3
SCRAPE_NAV_TIMEOUT_MS=20000
SCRAPE_DATA_TIMEOUT_MS=25000
SCRAPE_ATTEMPT_TIMEOUT_MS=60000
SCRAPE_RETRY_BASE_DELAY_MS=1500
# Optional: use a Chromium/Chrome you already have instead of Playwright download
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
